# Required: create this variable in Railway -> Service -> Variables.
# Never commit the real token to GitHub.
TELEGRAM_BOT_TOKEN=replace_with_your_botfather_token

# Optional: URL to a compatible model artifact if you do not bundle it in the image.
# The repository model is used by default when present.
# ZKAHIN_MODEL_URL=https://example.com/zkahin_bot_model.pkl

# Optional: writable cache location. Railway container filesystems are ephemeral.
# Leave unset to use the repository's default model path.
# ZKAHIN_CACHE_PATH=/tmp/zkahin_bot_model.pkl

# Optional logging / HTTP health server settings
LOG_LEVEL=INFO
HTTP_HOST=0.0.0.0
# Railway provides PORT automatically; do not hardcode it in Railway Variables.
